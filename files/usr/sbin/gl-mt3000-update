#!/bin/sh
# Check, download, or install the latest GL-MT3000 firmware from this project's
# GitHub Releases. This updater never uses the upstream OpenWrt release server.

set -eu

RELEASE_FILE=${GL_MT3000_RELEASE_FILE:-/etc/gl-mt3000-release}
UPDATE_CONFIG=gl-mt3000-update
LOCK_FILE=/tmp/gl-mt3000-update.lock.d
IMAGE_FILE=/tmp/gl-mt3000-update.bin
CHECKSUM_FILE=/tmp/gl-mt3000-update.sha256sums

usage() {
	cat <<'USAGE'
Usage: gl-mt3000-update [command] [options]

Commands:
  check     Query this repository's latest GitHub Release (default)
  download  Download and verify the latest firmware image
  upgrade   Download, verify, test, and sysupgrade to the latest image

Options:
  --force   Allow flashing when the latest Release tag equals this firmware
  -h        Show this help
USAGE
}

die() {
	echo "gl-mt3000-update: $*" >&2
	exit 1
}

uci_value() {
	uci -q get "$UPDATE_CONFIG.$1.$2" 2>/dev/null || true
}

json_value() {
	jsonfilter -s "$1" -e "$2" 2>/dev/null || true
}

cleanup() {
	rm -rf "$LOCK_FILE"
}
trap cleanup EXIT INT TERM

[ "$(id -u)" = 0 ] || die 'must be run as root'
mkdir "$LOCK_FILE" 2>/dev/null || die 'another update is already running'

COMMAND=check
FORCE=0
for arg in "$@"; do
	case "$arg" in
		check|download|upgrade) COMMAND="$arg" ;;
		--force) FORCE=1 ;;
		-h|--help) usage; exit 0 ;;
		*) usage >&2; die "unknown argument: $arg" ;;
	esac
done

ENABLED="$(uci_value repository enabled)"
[ "${ENABLED:-1}" = 1 ] || die 'online update is disabled in UCI'

OWNER="$(uci_value repository owner)"
REPO="$(uci_value repository repo)"
CHANNEL="$(uci_value repository channel)"
: "${OWNER:=yaotutu}"
: "${REPO:=gl-mt3000-openwrt}"
: "${CHANNEL:=imagebuilder}"
[ "$CHANNEL" = imagebuilder ] || die "unsupported update channel: $CHANNEL"

if [ -r "$RELEASE_FILE" ]; then
	. "$RELEASE_FILE"
fi
CURRENT_TAG="${BUILD_TAG:-unknown}"

API_URL="https://api.github.com/repos/$OWNER/$REPO/releases/latest"
LATEST_JSON="$(curl -fsSL --retry 3 -H 'Accept: application/vnd.github+json' "$API_URL")" ||
	die "failed to query GitHub Releases"
LATEST_TAG="$(json_value "$LATEST_JSON" '@.tag_name')"
[ -n "$LATEST_TAG" ] || die 'latest Release tag not found'

if [ "$CURRENT_TAG" = "$LATEST_TAG" ] && [ "$FORCE" != 1 ]; then
	echo "Firmware is up to date: $LATEST_TAG"
	exit 0
fi

IMAGE_URL="$(json_value "$LATEST_JSON" '@.assets[*].browser_download_url' | grep -E '/openwrt-.*-mediatek-filogic-glinet_gl-mt3000-squashfs-sysupgrade\.bin$' | head -n 1)"
CHECKSUM_URL="$(json_value "$LATEST_JSON" '@.assets[*].browser_download_url' | grep -E '/sha256sums$' | head -n 1)"
[ -n "$IMAGE_URL" ] || die "latest firmware asset not found in $LATEST_TAG"
[ -n "$CHECKSUM_URL" ] || die "sha256sums asset not found in $LATEST_TAG"

case "$COMMAND" in
	check)
		echo "Update target:"
		echo "  current: $CURRENT_TAG"
		echo "  latest:  $LATEST_TAG"
		echo "  image:   $IMAGE_URL"
		exit 0
		;;
	download|upgrade) ;;
esac

echo "Downloading $LATEST_TAG..."
curl -fsSL --retry 3 "$CHECKSUM_URL" -o "$CHECKSUM_FILE" || die 'failed to download sha256sums'
curl -fsSL --retry 3 "$IMAGE_URL" -o "$IMAGE_FILE" || die 'failed to download firmware image'

IMAGE_NAME="${IMAGE_URL##*/}"
EXPECTED_SHA256="$(awk -v file="$IMAGE_NAME" '$2 == "*" file { print $1; exit }' "$CHECKSUM_FILE")"
[ -n "$EXPECTED_SHA256" ] || die "checksum entry not found for $IMAGE_NAME"
ACTUAL_SHA256="$(sha256sum "$IMAGE_FILE" | awk '{print $1}')"
[ "$ACTUAL_SHA256" = "$EXPECTED_SHA256" ] || die "sha256 mismatch: expected $EXPECTED_SHA256, got $ACTUAL_SHA256"

[ "$(uci_value policy verify_sha256)" = 1 ] || die 'SHA256 verification must stay enabled'
TEST_IMAGE="$(uci_value policy test_image)"
if [ "${TEST_IMAGE:-1}" = 1 ]; then
	sysupgrade -T "$IMAGE_FILE" >/dev/null || die "sysupgrade rejected the image"
fi

case "$COMMAND" in
	download)
		echo "Downloaded and verified: $IMAGE_FILE"
		echo "Release: $LATEST_TAG"
		exit 0
		;;
	upgrade)
		KEEP_SETTINGS="$(uci_value policy keep_settings)"
		rm -rf "$LOCK_FILE"
		if [ "${KEEP_SETTINGS:-1}" = 1 ]; then
			echo "Upgrading to $LATEST_TAG while keeping settings..."
			exec sysupgrade -v "$IMAGE_FILE"
		else
			echo "Upgrading to $LATEST_TAG without keeping settings..."
			exec sysupgrade -n -v "$IMAGE_FILE"
		fi
		;;
esac
