{
	"luci-app-gl-mt3000-update": {
		"description": "Grant access to GL-MT3000 self-repository firmware updates",
		"read": {
			"file": {
				"/etc/gl-mt3000-release": [ "read" ],
				"/usr/sbin/gl-mt3000-update check": [ "exec" ],
				"/usr/sbin/gl-mt3000-update check --force": [ "exec" ]
			},
			"ubus": {
				"file": [ "exec", "read" ]
			}
		},
		"write": {
			"file": {
				"/usr/sbin/gl-mt3000-update download": [ "exec" ],
				"/usr/sbin/gl-mt3000-update download --force": [ "exec" ],
				"/usr/sbin/gl-mt3000-update upgrade": [ "exec" ],
				"/usr/sbin/gl-mt3000-update upgrade --force": [ "exec" ]
			},
			"ubus": {
				"file": [ "exec" ]
			}
		}
	}
}
