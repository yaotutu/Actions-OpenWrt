#!/bin/sh

# Keep Nikki installed but inactive until a valid subscription/profile is added.
uci -q set nikki.config.enabled='0'
uci -q set nikki.config.core_only='0'
uci -q set nikki.config.test_profile='1'

# Use the bundled dashboard and a fixed download URL for manual dashboard updates.
uci -q set nikki.mixin.ui_path='ui'
uci -q delete nikki.mixin.ui_name
uci -q set nikki.mixin.ui_url='https://github.com/Zephyruso/zashboard/releases/download/v3.11.0/dist.zip'
uci -q set nikki.mixin.api_listen='[::]:9090'

# Prefer redir-host so the default setup avoids Fake-IP behavior.
uci -q set nikki.mixin.dns_mode='redir-host'
uci -q set nikki.proxy.fake_ip_ping_hijack='0'

# GeoX data is bundled under /etc/nikki/run/:
# geoip.metadb for GEOIP rules, plus geoip.dat/geosite.dat for future profiles.
# Keep automatic GeoX refresh off so first boot does not depend on GitHub assets.
uci -q set nikki.mixin.geox_auto_update='0'

uci -q commit nikki

exit 0
